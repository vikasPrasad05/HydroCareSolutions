  function renderRecentEnquiryRow(inq: any): string {
    const dateObj = inq.created_at ? new Date(inq.created_at) : new Date();
    const day = String(dateObj.getDate()).padStart(2, '0');
    const month = String(dateObj.getMonth() + 1).padStart(2, '0');
    const year = dateObj.getFullYear();
    const formattedDate = `${day}/${month}/${year}`;
    const statusLower = (inq.status || 'pending').toLowerCase();
    const inqJsonEscaped = escapeHtml(JSON.stringify(inq));

    return `
      <div 
        class="enquiry-item-row" 
        data-id="${escapeHtml(inq.id)}"
        data-json="${inqJsonEscaped}"
      >
        <div class="enquiry-item-left">
          <h4 class="company-name">${escapeHtml(inq.company_name || inq.name || 'Unknown Company')}</h4>
          <p class="company-sub">${escapeHtml(inq.product_name || 'Inquiry')} · ${Number(inq.quantity || 0).toLocaleString()} units</p>
        </div>

        <div class="enquiry-item-right">
          <span class="status-badge-pill ${escapeHtml(statusLower)}">
            ${escapeHtml(statusLower)}
          </span>
          <span class="enquiry-date">${formattedDate}</span>
        </div>
      </div>
    `;
  }

  // Keep track of known inquiry IDs in memory
  const knownInquiryIds = new Set<string>();
  document.querySelectorAll<HTMLTableRowElement>('#enquiriesTableBody tr.enquiry-row-item').forEach(r => {
    const id = r.getAttribute('data-id');
    if (id) knownInquiryIds.add(id);
  });

  function attachEnquiryRowEvents() {
    // View details modal buttons
    document.querySelectorAll<HTMLElement>('.view-inquiry-btn').forEach(btn => {
      btn.onclick = (e) => {
        e.stopPropagation();
        const dataStr = btn.getAttribute('data-inquiry');
        if (dataStr) {
          try {
            openInquiryModal(JSON.parse(dataStr));
          } catch {}
        }
      };
    });

    // Single delete buttons
    document.querySelectorAll<HTMLElement>('.delete-inquiry-btn').forEach(btn => {
      btn.onclick = async (e) => {
        e.stopPropagation();
        const id = btn.getAttribute('data-id');
        if (!id) return;

        if (!confirm('Are you sure you want to delete this enquiry?')) return;

        try {
          const res = await fetch(`/api/inquiries/${id}`, { method: 'DELETE' });
          if (res.ok) {
            knownInquiryIds.delete(id);
            const row = btn.closest('tr');
            row?.remove();
            filterAndPaginateEnquiries();
            showToast('Enquiry deleted successfully');
          } else {
            showToast('Failed to delete enquiry', true);
          }
        } catch (err: any) {
          showToast(err.message || 'Error deleting enquiry', true);
        }
      };
    });

    // Recent items click on dashboard
    document.querySelectorAll<HTMLElement>('.enquiry-item-row').forEach(row => {
      row.onclick = () => {
        const dataStr = row.getAttribute('data-json');
        if (dataStr) {
          try {
            openInquiryModal(JSON.parse(dataStr));
          } catch {}
        }
      };
    });
  }

  let isFetchingInquiries = false;

  async function checkAndUpdateInquiries(isManual: boolean = false) {
    if (isFetchingInquiries) return;
    isFetchingInquiries = true;

    const refreshBtn = document.getElementById('manualRefreshBtn');
    if (isManual && refreshBtn) {
      refreshBtn.classList.add('refreshing');
    }

    try {
      const res = await fetch('/api/inquiries', { credentials: 'same-origin' });
      if (!res.ok) {
        if (res.status === 401) {
          console.warn('[Real-Time Sync] Admin session unauthorized');
        }
        return;
      }

      const data = await res.json();
      if (!data.success || !Array.isArray(data.inquiries)) return;

      const freshInquiries: any[] = data.inquiries;
      
      // Detect brand-new inquiries
      const newItems = freshInquiries.filter(i => !knownInquiryIds.has(i.id));
      const hasNewItems = newItems.length > 0;
      const countChanged = freshInquiries.length !== knownInquiryIds.size;

      if (hasNewItems || countChanged || isManual) {
        const hadPrevious = knownInquiryIds.size > 0;
        const prevSet = new Set(knownInquiryIds);

        // Update known IDs
        knownInquiryIds.clear();
        freshInquiries.forEach(i => knownInquiryIds.add(i.id));

        // Re-render full enquiries table
        const tbody = document.getElementById('enquiriesTableBody');
        if (tbody) {
          tbody.innerHTML = freshInquiries.map(inq => {
            const isFresh = hadPrevious && !prevSet.has(inq.id);
            return renderEnquiryRow(inq, isFresh);
          }).join('');
        }

        // Re-render dashboard recent list
        const recentList = document.getElementById('recentEnquiriesList');
        if (recentList) {
          recentList.innerHTML = freshInquiries.slice(0, 5).map(inq => renderRecentEnquiryRow(inq)).join('');
        }

        // Update Dashboard Metric Counters
        const totalCount = freshInquiries.length;
        const pendingCount = freshInquiries.filter(i => {
          const s = (i.status || '').toUpperCase();
          return s === 'PENDING' || s === 'NEW';
        }).length;

        const totalEl = document.getElementById('dashboardTotalEnquiries');
        if (totalEl) totalEl.textContent = String(totalCount);

        const pendingEl = document.getElementById('dashboardPendingEnquiries');
        if (pendingEl) pendingEl.textContent = String(pendingCount);

        // Update Sidebar Badge
        const sidebarBadge = document.getElementById('sidebarEnquiriesBadge');
        if (sidebarBadge) {
          sidebarBadge.textContent = String(pendingCount);
          sidebarBadge.style.display = pendingCount > 0 ? 'inline-flex' : 'none';
        }

        // Re-attach event handlers & pagination
        attachEnquiryRowEvents();
        filterAndPaginateEnquiries();

        if (hasNewItems && hadPrevious) {
          playNotificationSound();
          const latest = newItems[0];
          const clientName = latest.company_name || latest.name || 'New Client';
          const prodTitle = latest.product_name || 'Absorbent Pads';
          showToast(`🔔 New Quote Request from "${clientName}" (${prodTitle})!`, false);

          const originalTitle = document.title;
          document.title = `(${newItems.length} New) ${originalTitle}`;
          setTimeout(() => { document.title = originalTitle; }, 7000);
        } else if (isManual) {
          showToast('Enquiries list refreshed successfully');
        }
      }
    } catch (err: any) {
      console.error('[Real-Time Sync Error]:', err);
      if (isManual) showToast('Failed to refresh enquiries', true);
    } finally {
      isFetchingInquiries = false;
      if (refreshBtn) {
        refreshBtn.classList.remove('refreshing');
      }
    }
  }

  // Initial event bindings
  attachEnquiryRowEvents();
