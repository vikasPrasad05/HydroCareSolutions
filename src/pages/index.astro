  <script>
    document.querySelectorAll('.btn-open-track-modal').forEach(btn => {
      btn.addEventListener('click', (e) => {
        e.preventDefault();
        if ((window as any).openTrackQuoteModal) {
          (window as any).openTrackQuoteModal();
        }
      });
    });

    // Live sync offer updates from admin
    async function syncOfferFromAdmin() {
      try {
        const res = await fetch('/api/offer');
        if (!res.ok) return;
        const data = await res.json();
        if (!data.success || !data.offer) return;
        const offer = data.offer;
        
        const divider = document.getElementById('homeOfferDivider');
        const titleEl = document.getElementById('homeOfferTitle');
        const descEl = document.getElementById('homeOfferDesc');
        const btnTextEl = document.getElementById('homeOfferBtnText');
        const cardEl = document.getElementById('homeOfferCard') as HTMLAnchorElement;

        if (divider) {
          divider.style.display = offer.active ? 'block' : 'none';
        }

        if (titleEl && offer.title) titleEl.textContent = offer.title;
        if (descEl && offer.description) descEl.textContent = offer.description;
        if (btnTextEl && offer.buttonText) btnTextEl.textContent = offer.buttonText;
        if (cardEl && offer.linkUrl) {
          cardEl.href = offer.linkUrl;
        }
      } catch (e) {}
    }

    window.addEventListener('focus', syncOfferFromAdmin);
    setInterval(syncOfferFromAdmin, 10000);

    // Dynamic Hero 4-Photo Rotator (Auto-cycles through real product pads)
    function setupHeroRotators() {
      const rotators = document.querySelectorAll('.dynamic-rotator');
      rotators.forEach((rotator) => {
        const slides = rotator.querySelectorAll('.rotator-slide');
        const dots = rotator.querySelectorAll('.rotator-dot');
        if (slides.length <= 1) return;

        let currentIndex = 0;
        const intervalTime = parseInt(rotator.getAttribute('data-interval') || '4500', 10);
        let isPaused = false;

        function showSlide(index: number) {
          slides.forEach((s, idx) => {
            s.classList.toggle('active', idx === index);
          });
          dots.forEach((d, idx) => {
            d.classList.toggle('active', idx === index);
          });
          currentIndex = index;
        }

        function nextSlide() {
          if (isPaused) return;
          const nextIdx = (currentIndex + 1) % slides.length;
          showSlide(nextIdx);
        }

        setInterval(nextSlide, intervalTime);

        rotator.addEventListener('mouseenter', () => {
          isPaused = true;
        });

        rotator.addEventListener('mouseleave', () => {
          isPaused = false;
        });
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', setupHeroRotators);
    } else {
      setupHeroRotators();
    }
  </script>
