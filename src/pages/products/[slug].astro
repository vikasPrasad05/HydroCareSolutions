<script>
  // Thumbnail & Multi-Photo Switcher
  const mainImg = document.getElementById('mainProductImg') as HTMLImageElement;
  const galleryBadge = document.getElementById('galleryBadge');
  const thumbBtns = document.querySelectorAll('.thumb-btn');

  function updateMainPhoto(src: string, label?: string) {
    if (!mainImg || !src) return;
    mainImg.style.opacity = '0.35';
    setTimeout(() => {
      mainImg.src = src;
      mainImg.style.opacity = '1';
      if (galleryBadge && label) {
        galleryBadge.textContent = label;
      }
    }, 120);
  }

  thumbBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      const targetSrc = btn.getAttribute('data-img');
      const title = btn.getAttribute('data-title') || '';
      if (targetSrc) {
        updateMainPhoto(targetSrc, title);
      }
      thumbBtns.forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
    });
  });

  // Size Pills Active Selector
  const sizeContainer = document.getElementById('sizePills');
  if (sizeContainer) {
    const sizePills = sizeContainer.querySelectorAll('.pill-btn');
    sizePills.forEach(pill => {
      pill.addEventListener('click', () => {
        sizePills.forEach(p => p.classList.remove('active'));
        pill.classList.add('active');
      });
    });
  }

  // Color Swatch Pills Active Selector & Image Switcher
  const colorContainer = document.getElementById('colorPills');
  const selectedColorLabel = document.getElementById('selectedColorLabel');
  if (colorContainer) {
    const colorPills = colorContainer.querySelectorAll('.color-pill-btn');
    colorPills.forEach(pill => {
      pill.addEventListener('click', () => {
        colorPills.forEach(p => p.classList.remove('active'));
        pill.classList.add('active');

        const colorName = pill.getAttribute('data-val');
        const colorImg = pill.getAttribute('data-img');

        if (selectedColorLabel && colorName) {
          selectedColorLabel.textContent = colorName;
        }

        if (colorImg) {
          updateMainPhoto(colorImg, `${colorName} Pad`);
          // Sync with thumb if it exists
          thumbBtns.forEach(tb => {
            if (tb.getAttribute('data-img') === colorImg) {
              thumbBtns.forEach(b => b.classList.remove('active'));
              tb.classList.add('active');
            }
          });
        }
      });
    });
  }
</script>
