  syncD1Btn?.addEventListener('click', async () => {
    if (syncD1Btn) {
      (syncD1Btn as HTMLButtonElement).innerText = 'Connecting to Cloudflare...';
      (syncD1Btn as HTMLButtonElement).disabled = true;
    }
    if (d1SyncResult) d1SyncResult.style.display = 'none';

    try {
      const res = await fetch('/api/admin/init-d1', { method: 'POST' });
      const data = await res.json();
      if (d1SyncResult) {
        d1SyncResult.style.display = 'block';
        if (res.ok && data.ok) {
          d1SyncResult.style.background = '#ECFDF5';
          d1SyncResult.style.border = '1px solid #A7F3D0';
          d1SyncResult.style.color = '#065F46';
          d1SyncResult.innerText = '✓ ' + data.message + ' (Tables: ' + (data.tables || []).join(', ') + ')';
          showToast('D1 database synced successfully!');
        } else {
          d1SyncResult.style.background = '#FEF2F2';
          d1SyncResult.style.border = '1px solid #FECACA';
          d1SyncResult.style.color = '#991B1B';
          d1SyncResult.innerText = '✗ ' + (data.error || 'Connection failed.');
          showToast('D1 sync: ' + (data.error || 'Failed'), true);
        }
      }
    } catch (err: any) {
      if (d1SyncResult) {
        d1SyncResult.style.display = 'block';
        d1SyncResult.style.background = '#FEF2F2';
        d1SyncResult.style.border = '1px solid #FECACA';
        d1SyncResult.style.color = '#991B1B';
        d1SyncResult.innerText = '✗ ' + (err.message || 'Failed connecting to D1');
