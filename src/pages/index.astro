---
import Layout from '../layouts/Layout.astro';
import ProductCard from '../components/ProductCard.astro';
import ProductionStats from '../components/ProductionStats.astro';
import { getAllProducts, getOffer } from '../lib/store';

const products = await getAllProducts();
const activeProducts = products.filter(p => p.is_active);
// Show 2 complete lines (8 products) on the homepage
const homeProducts = activeProducts.slice(0, 8);
const currentOffer = await getOffer();
const whatsappNumber = import.meta.env.COMPANY_WHATSAPP || '917623906747';

// 4-Card Hero Collage Dynamic Product Rotator Slides
const meatSlides = [
  { image: '/images/products/quilted-meat-tray-pad.jpg', tag: 'MEAT ABSORBENT PADS', link: '/products/fresh-meat-drip-pads' },
  { image: '/images/products/black-beef-steak-pad.jpg', tag: 'BLACK GOURMET PADS', link: '/products/black-beef-steak-absorbent-pads' },
  { image: '/images/products/ultrasonic-sealed-pad-macro.jpg', tag: 'ULTRASONIC SEALED PADS', link: '/products/ultrasonic-sealed-pads' },
  { image: '/images/products/soaker-pads-color-variants.jpg', tag: '5-COLOR TRAY PADS', link: '/products/multi-color-food-grade-soaker-pads' },
  { image: '/images/products/poultry-purge-absorbers.jpg', tag: 'POULTRY PURGE ABSORBERS', link: '/products/poultry-purge-absorbers' }
];

const coldChainSlides = [
  { image: '/images/hero/cold-chain-pads.jpg', tag: 'COLD CHAIN ICE PADS', link: '/products/cold-chain-ice-absorbent-pads' },
  { image: '/images/products/continuous-perforated-rolls.jpg', tag: 'PERFORATED ROLL DISPENSER', link: '/products/continuous-perforated-rolls' },
  { image: '/images/products/industrial-soaker-pads.jpg', tag: 'HEAVY-DUTY PREP SOAKERS', link: '/products/industrial-commercial-soaker-pads' },
  { image: '/images/products/carcass-soaker-liners.jpg', tag: 'CARCASS WRAP LINERS', link: '/products/slaughterhouse-carcass-liners' }
];

const fruitSlides = [
  { image: '/images/products/fruit-punnet-cushion-pad.jpg', tag: 'HONEYCOMB BERRY PADS', link: '/products/fruit-and-berry-absorbent-pads' },
  { image: '/images/hero/fruit-pads.jpg', tag: 'FRUIT & VEGETABLE PADS', link: '/products/breathable-produce-pads' },
  { image: '/images/products/fruit-punnet-colored-pads.jpg', tag: 'PUNNET CUSHIONING LINERS', link: '/products/clamshell-punnet-berry-liners' },
  { image: '/images/products/grape-tomato-soakers.jpg', tag: 'GRAPE & TOMATO SOAKERS', link: '/products/grape-tomato-soakers' }
];

const seafoodSlides = [
  { image: '/images/products/marine-seafood-pad-macro.jpg', tag: 'MARINE SEAFOOD DRIP PADS', link: '/products/marine-seafood-absorbent-pads' },
  { image: '/images/hero/seafood-pads.jpg', tag: 'SALMON DISPLAY TRAY PADS', link: '/products/marine-seafood-absorbent-pads' },
  { image: '/images/products/salmon-export-sheets.jpg', tag: 'SALMON EXPORT SHEETS', link: '/products/salmon-box-export-sheets' },
  { image: '/images/products/antimicrobial-odor-liner.jpg', tag: 'ANTIMICROBIAL ODOR LINERS', link: '/products/antimicrobial-odor-liners' },
  { image: '/images/products/prawn-shrimp-soakers.jpg', tag: 'PRAWN & SHRIMP SOAKERS', link: '/products/prawn-shrimp-soaker-sheets' }
];
---

<Layout 
  title="HydroCare Solutions — Food-Grade Absorbent Pads Manufacturer India"
  description="Primary B2B manufacturer of food-grade absorbent drip pads for fresh meat, poultry, seafood, berries, and cold chain logistics. Certified cleanroom converting facility."
  currentPath="/"
>
  <!-- Hero Section -->
  <section class="hero-section">
    <!-- Animated 3-Column Background Moving Columns (Product Showcase Marquee) -->
    <div class="hero-bg-columns-backdrop" aria-hidden="true">
      <div class="hero-bg-columns-grid">
        
        <!-- Column 1: Moves Down (3 images duplicated for infinite loop) -->
        <div class="hero-bg-col col-move-down">
          <div class="hero-bg-col-track">
            <!-- Group 1 -->
            <div class="track-group">
              <div class="bg-product-card">
                <img src="/images/products/meat-pads.jpg" alt="" class="bg-product-img" loading="eager" />
                <span class="bg-card-glass-tag">Meat Absorbent Pads</span>
              </div>
              <div class="bg-product-card">
                <img src="/images/products/fruit-pads.jpg" alt="" class="bg-product-img" loading="eager" />
                <span class="bg-card-glass-tag">Fruit & Berry Cushioning</span>
              </div>
              <div class="bg-product-card">
                <img src="/images/products/seafood-pads.jpg" alt="" class="bg-product-img" loading="eager" />
                <span class="bg-card-glass-tag">Marine Seafood Pads</span>
              </div>
            </div>
            <!-- Group 2 (Duplicate for seamless loop) -->
            <div class="track-group">
              <div class="bg-product-card">
                <img src="/images/products/meat-pads.jpg" alt="" class="bg-product-img" loading="eager" />
                <span class="bg-card-glass-tag">Meat Absorbent Pads</span>
              </div>
              <div class="bg-product-card">
                <img src="/images/products/fruit-pads.jpg" alt="" class="bg-product-img" loading="eager" />
                <span class="bg-card-glass-tag">Fruit & Berry Cushioning</span>
              </div>
              <div class="bg-product-card">
                <img src="/images/products/seafood-pads.jpg" alt="" class="bg-product-img" loading="eager" />
                <span class="bg-card-glass-tag">Marine Seafood Pads</span>
              </div>
            </div>
          </div>
        </div>

        <!-- Column 2: Moves Up (3 images duplicated for infinite loop) -->
        <div class="hero-bg-col col-move-up">
          <div class="hero-bg-col-track">
            <!-- Group 1 -->
            <div class="track-group">
              <div class="bg-product-card">
                <img src="/images/hero/cold-chain-pads.jpg" alt="" class="bg-product-img" loading="eager" />
                <span class="bg-card-glass-tag">Cold Chain Ice Soakers</span>
              </div>
              <div class="bg-product-card">
                <img src="/images/products/industrial-soaker-pads.jpg" alt="" class="bg-product-img" loading="eager" />
                <span class="bg-card-glass-tag">Industrial Soaker Mats</span>
              </div>
              <div class="bg-product-card">
                <img src="/images/products/fruit-punnet-colored-pads.jpg" alt="" class="bg-product-img" loading="eager" />
                <span class="bg-card-glass-tag">Perforated Punnet Pads</span>
              </div>
            </div>
            <!-- Group 2 (Duplicate for seamless loop) -->
            <div class="track-group">
              <div class="bg-product-card">
                <img src="/images/hero/cold-chain-pads.jpg" alt="" class="bg-product-img" loading="eager" />
                <span class="bg-card-glass-tag">Cold Chain Ice Soakers</span>
              </div>
              <div class="bg-product-card">
                <img src="/images/products/industrial-soaker-pads.jpg" alt="" class="bg-product-img" loading="eager" />
                <span class="bg-card-glass-tag">Industrial Soaker Mats</span>
              </div>
              <div class="bg-product-card">
                <img src="/images/products/fruit-punnet-colored-pads.jpg" alt="" class="bg-product-img" loading="eager" />
                <span class="bg-card-glass-tag">Perforated Punnet Pads</span>
              </div>
            </div>
          </div>
        </div>

        <!-- Column 3: Moves Down (3 images duplicated for infinite loop) -->
        <div class="hero-bg-col col-move-down col-3-down">
          <div class="hero-bg-col-track">
            <!-- Group 1 -->
            <div class="track-group">
              <div class="bg-product-card">
                <img src="/images/products/meat-fish-poultry-demo.jpg" alt="" class="bg-product-img" loading="eager" />
                <span class="bg-card-glass-tag">Poultry & Meat Barrier</span>
              </div>
              <div class="bg-product-card">
                <img src="/images/products/white-black-pads.jpg" alt="" class="bg-product-img" loading="eager" />
                <span class="bg-card-glass-tag">Black & White Soakers</span>
              </div>
              <div class="bg-product-card">
                <img src="/images/about/soaker-absorbent-pads-structure.jpg" alt="" class="bg-product-img" loading="eager" />
                <span class="bg-card-glass-tag">Multi-Layer Core Pad</span>
              </div>
            </div>
            <!-- Group 2 (Duplicate for seamless loop) -->
            <div class="track-group">
              <div class="bg-product-card">
                <img src="/images/products/meat-fish-poultry-demo.jpg" alt="" class="bg-product-img" loading="eager" />
                <span class="bg-card-glass-tag">Poultry & Meat Barrier</span>
              </div>
              <div class="bg-product-card">
                <img src="/images/products/white-black-pads.jpg" alt="" class="bg-product-img" loading="eager" />
                <span class="bg-card-glass-tag">Black & White Soakers</span>
              </div>
              <div class="bg-product-card">
                <img src="/images/about/soaker-absorbent-pads-structure.jpg" alt="" class="bg-product-img" loading="eager" />
                <span class="bg-card-glass-tag">Multi-Layer Core Pad</span>
              </div>
            </div>
          </div>
        </div>

      </div>

      <!-- Translucent soft veil so foreground text and search bar stay crisp and readable -->
      <div class="hero-bg-overlay-veil"></div>
    </div>

    <div class="hero-bg-glow"></div>
    <div class="container-apparel hero-container">
      <div class="hero-grid">
        
        <!-- Hero Left: Content, Search & Trust Badges -->
        <div class="hero-content">
          <!-- Main Heading -->
          <h1 class="hero-title">
            <span class="hero-title-main">Primary Manufacturer of</span>
            <span class="hero-title-accent">
              <span class="hero-word-blue">Food-Grade</span> <span class="hero-word-green">Absorbent Pads</span>
            </span>
          </h1>

          <!-- Subtitle -->
          <p class="hero-subtitle">
            Certified cleanroom manufacturing of high-performance soaker pads for <strong>Fresh Meat, Poultry, Seafood, Berries & Cold Chain Logistics</strong>. FDA 21 CFR & FSSAI food contact certified with 0% middleman markup.
          </p>

          <!-- Search Bar -->
          <form action="/catalogue" method="GET" class="search-form-row">
            <div class="search-input-wrap">
              <svg class="search-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="11" cy="11" r="8"></circle>
                <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
              </svg>
              <input 
                type="text" 
                name="q" 
                class="search-input" 
                placeholder="Search meat pads, seafood soakers, berry cushioning, cold chain..." 
                aria-label="Search absorbent pads and products"
              />
            </div>
            <button type="submit" class="search-submit-btn">
              <span>Search</span>
              <span class="search-btn-arrow">&rarr;</span>
            </button>
          </form>

          <!-- Brand Feature Highlights (Superior Absorption, Leak Proof, Eco Friendly, Custom Sizes, Trusted Quality) -->
          <div class="hero-brand-features-row">
            <!-- 1. Superior Absorption -->
            <div class="hero-feature-item">
              <div class="feature-circle circle-blue" title="Superior Absorption">
                <svg viewBox="0 0 24 24" width="28" height="28" fill="currentColor">
                  <path fill-rule="evenodd" clip-rule="evenodd" d="M12 3.2L6.34 8.86a8 8 0 1 0 11.32 0L12 3.2zm0 4.24l3.54 3.54a5 5 0 1 1-7.08 0L12 7.44z"/>
                </svg>
              </div>
              <div class="feature-label">
                <span>SUPERIOR</span>
                <span>ABSORPTION</span>
              </div>
            </div>

            <!-- 2. Leak Proof Protection -->
            <div class="hero-feature-item">
              <div class="feature-circle circle-green" title="Leak Proof Protection">
                <svg viewBox="0 0 24 24" width="28" height="28" fill="currentColor">
                  <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2L4 5v6.09c0 5.05 3.41 9.76 8 10.91 4.59-1.15 8-5.86 8-10.91V5l-8-3zm0 2.87l6 2.25v4.97c0 3.88-2.55 7.48-6 8.52-3.45-1.04-6-4.64-6-8.52V7.12l6-2.25z"/>
                </svg>
              </div>
              <div class="feature-label">
                <span>LEAK PROOF</span>
                <span>PROTECTION</span>
              </div>
            </div>

            <!-- 3. Eco Friendly Solutions -->
            <div class="hero-feature-item">
              <div class="feature-circle circle-orange" title="Eco Friendly Solutions">
                <svg viewBox="0 0 24 24" width="28" height="28" fill="none">
                  <path d="M20.5 3.5c-7.5.5-13.5 4.5-15 11.5-.5 2.5 0 4.5 0 4.5s2 .5 4.5 0c7-1.5 11-7.5 11.5-15z" fill="#FFFFFF"/>
                  <path d="M5.5 19.5c2-3 5.5-6.5 10-9" stroke="#FA6400" stroke-width="2.4" stroke-linecap="round"/>
                </svg>
              </div>
              <div class="feature-label">
                <span>ECO FRIENDLY</span>
                <span>SOLUTIONS</span>
              </div>
            </div>

            <!-- 4. Custom Sizes & Design -->
            <div class="hero-feature-item">
              <div class="feature-circle circle-purple" title="Custom Sizes & Design">
                <svg viewBox="0 0 24 24" width="28" height="28" fill="currentColor">
                  <path fill-rule="evenodd" clip-rule="evenodd" d="M19.14 12.94c.04-.3.06-.61.06-.94 0-.32-.02-.64-.07-.94l2.03-1.58a.49.49 0 0 0 .12-.61l-1.92-3.32a.49.49 0 0 0-.59-.22l-2.39.96c-.5-.38-1.03-.7-1.62-.94l-.36-2.54A.484.484 0 0 0 14 2h-4c-.25 0-.46.18-.49.42l-.36 2.54c-.59.24-1.13.57-1.62.94l-2.39-.96c-.22-.08-.47 0-.59.22L2.63 8.49c-.14.24-.08.54.12.61l2.03 1.58c-.05.3-.09.63-.09.94s.02.64.07.94l-2.03 1.58a.49.49 0 0 0-.12.61l1.92 3.32c.12.22.37.29.59.22l2.39-.96c.5.38 1.03.7 1.62.94l.36 2.54c.05.24.24.41.48.41h4c.25 0 .46-.18.49-.42l.36-2.54c.59-.24 1.13-.56 1.62-.94l2.39.96c.22.08.47 0 .59-.22l1.92-3.32c.12-.22.07-.54-.12-.61l-2.01-1.58zM12 15.5c-1.93 0-3.5-1.57-3.5-3.5s1.57-3.5 3.5-3.5 3.5 1.57 3.5 3.5-1.57 3.5-3.5 3.5z"/>
                </svg>
              </div>
              <div class="feature-label">
                <span>CUSTOM SIZES</span>
                <span>& DESIGN</span>
              </div>
            </div>

            <!-- 5. Trusted Quality -->
            <div class="hero-feature-item">
              <div class="feature-circle circle-red" title="Trusted Quality">
                <svg viewBox="0 0 24 24" width="28" height="28" fill="currentColor">
                  <path d="M21.71 8.71l-2.42-2.42a2.003 2.003 0 0 0-2.83 0l-2.46 2.46-1.71-1.71a2.003 2.003 0 0 0-2.83 0L7.17 9.33a2.003 2.003 0 0 0 0 2.83l1.41 1.41-5.87 5.87a1 1 0 0 0 0 1.41l2.83 2.83a1 1 0 0 0 1.41 0l5.87-5.87 1.41 1.41a2.003 2.003 0 0 0 2.83 0l6.65-6.65a2.003 2.003 0 0 0 0-2.83l-2-2.03zM6.12 20.88l-1.41-1.41 5.17-5.17 1.41 1.41-5.17 5.17zm6.59-3.76l-1.41-1.41 1.41-1.41 1.41 1.41-1.41 1.41zm2.12-2.12l-1.41-1.41 1.41-1.41 1.41 1.41-1.41 1.41zm2.12-2.12l-1.41-1.41 1.41-1.41 1.41 1.41-1.41 1.41zm3.47-3.47l-1.41 1.41-1.41-1.41 1.41-1.41 1.41 1.41z"/>
                </svg>
              </div>
              <div class="feature-label">
                <span>TRUSTED</span>
                <span>QUALITY</span>
              </div>
            </div>
          </div>
        </div>

        <!-- Hero Right: 4-Photo Staggered Dynamic Rotator Collage & 2 Floating Cards -->
        <div class="hero-visual-collage">
          <div class="collage-container">
            <!-- Left Collage Column -->
            <div class="collage-col collage-col-1">
              <!-- Photo 1: Meat & Poultry Line (Auto-Cycling) -->
              <div class="collage-item item-flatlay dynamic-rotator" data-interval="4000" id="heroRotatorMeat">
                {meatSlides.map((slide, i) => (
                  <div 
                    class={`rotator-slide ${i === 0 ? 'active' : ''}`}
                    title={slide.tag}
                  >
                    <img 
                      src={slide.image} 
                      alt={slide.tag} 
                      class="collage-photo"
                      loading={i === 0 ? 'eager' : 'lazy'}
                    />
                    <span class="photo-overlay-tag">{slide.tag}</span>
                  </div>
                ))}
                <div class="rotator-dots" aria-hidden="true">
                  {meatSlides.map((_, i) => (
                    <span class={`rotator-dot ${i === 0 ? 'active' : ''}`}></span>
                  ))}
                </div>
              </div>

              <!-- Photo 2: Cold Chain Ice Pads Line (Auto-Cycling) -->
              <div class="collage-item item-rack dynamic-rotator" data-interval="4700" id="heroRotatorCold">
                {coldChainSlides.map((slide, i) => (
                  <div 
                    class={`rotator-slide ${i === 0 ? 'active' : ''}`}
                    title={slide.tag}
                  >
                    <img 
                      src={slide.image} 
                      alt={slide.tag} 
                      class="collage-photo"
                      loading={i === 0 ? 'eager' : 'lazy'}
                    />
                    <span class="photo-overlay-tag">{slide.tag}</span>
                  </div>
                ))}
                <div class="rotator-dots" aria-hidden="true">
                  {coldChainSlides.map((_, i) => (
                    <span class={`rotator-dot ${i === 0 ? 'active' : ''}`}></span>
                  ))}
                </div>
              </div>
            </div>

            <!-- Right Collage Column -->
            <div class="collage-col collage-col-2">
              <!-- Photo 3: Fruit & Vegetable Line (Auto-Cycling) -->
              <div class="collage-item item-wardrobe dynamic-rotator" data-interval="5400" id="heroRotatorFruit">
                {fruitSlides.map((slide, i) => (
                  <div 
                    class={`rotator-slide ${i === 0 ? 'active' : ''}`}
                    title={slide.tag}
                  >
                    <img 
                      src={slide.image} 
                      alt={slide.tag} 
                      class="collage-photo"
                      loading={i === 0 ? 'eager' : 'lazy'}
                    />
                    <span class="photo-overlay-tag">{slide.tag}</span>
                  </div>
                ))}
                <div class="rotator-dots" aria-hidden="true">
                  {fruitSlides.map((_, i) => (
                    <span class={`rotator-dot ${i === 0 ? 'active' : ''}`}></span>
                  ))}
                </div>
              </div>

              <!-- Photo 4: Seafood & Fishery Line (Auto-Cycling) -->
              <div class="collage-item item-dispatch dynamic-rotator" data-interval="6100" id="heroRotatorSeafood">
                {seafoodSlides.map((slide, i) => (
                  <div 
                    class={`rotator-slide ${i === 0 ? 'active' : ''}`}
                    title={slide.tag}
                  >
                    <img 
                      src={slide.image} 
                      alt={slide.tag} 
                      class="collage-photo"
                      loading={i === 0 ? 'eager' : 'lazy'}
                    />
                    <span class="photo-overlay-tag">{slide.tag}</span>
                  </div>
                ))}
                <div class="rotator-dots" aria-hidden="true">
                  {seafoodSlides.map((_, i) => (
                    <span class={`rotator-dot ${i === 0 ? 'active' : ''}`}></span>
                  ))}
                </div>

                <!-- Floating Fast Turnaround Badge (Overlapping bottom left) -->
                <div class="floating-badge-turnaround">
                  <div class="turnaround-hour-box">
                    <span>24h</span>
                  </div>
                  <div class="turnaround-text">
                    <span class="turnaround-title">Fast Turnaround</span>
                    <span class="turnaround-sub">Direct quotes &amp; dispatch</span>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- Animated Live Offer Divider Banner (Centered over divider line) -->
  <section class="offer-divider-section" id="homeOfferDivider" style={currentOffer && currentOffer.active ? '' : 'display: none;'}>
    <div class="offer-divider-line"></div>
    <div class="container-apparel offer-divider-container">
      <a 
        href={currentOffer && currentOffer.linkUrl ? currentOffer.linkUrl : '/enquiry'} 
        class="offer-banner-pill-card" 
        id="homeOfferCard"
        title="Click to claim offer"
      >
        <!-- Shimmer light sweep glare -->
        <span class="offer-shimmer-sweep"></span>

        <!-- Left Tag Icon Badge -->
        <div class="offer-pill-badge">
          <svg class="offer-badge-tag-icon" viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"></path>
            <line x1="7" y1="7" x2="7.01" y2="7"></line>
          </svg>
        </div>

        <!-- Middle Content -->
        <div class="offer-pill-content">
          <div class="offer-pill-top">
            <h3 class="offer-pill-title" id="homeOfferTitle">
              {currentOffer?.title || '10% off on tshirt bulk order'}
            </h3>
            <span class="offer-live-pill-tag">OFFER</span>
          </div>
          <p class="offer-pill-desc" id="homeOfferDesc">
            {currentOffer?.description || '10% off on tshirt bulk order above 5000 quant'}
          </p>
        </div>

        <!-- Right Action Button -->
        <div class="offer-pill-action">
          <span class="offer-action-text" id="homeOfferBtnText">{currentOffer?.buttonText || 'Claim offer'}</span>
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" class="offer-action-arrow">
            <polyline points="9 18 15 12 9 6"></polyline>
          </svg>
        </div>
      </a>
    </div>
  </section>

  <!-- Industrial Performance Metrics -->
  <ProductionStats />

  <!-- Featured Products Section -->
  <section class="section-products" id="products">
    <div class="container-apparel">
      <div class="section-header-flex">
        <div class="header-text-block">
          <span class="section-kicker">DIRECT FACTORY CATALOG</span>
          <h2 class="section-headline">Featured Product Lines</h2>
          <p class="section-subtext">
            Direct mill manufacturing across core certified lines. High absorbency, food contact safety, and tech-pack ready OEM supply.
          </p>
        </div>
        <div class="header-action-block">
          <a href="/catalogue" class="filter-pill filter-link">View All Catalog &rarr;</a>
        </div>
      </div>

      <!-- Products Grid (Exactly 4 Core Products on Home Page) -->
      <div class="products-grid-4">
        {homeProducts.map((product) => (
          <ProductCard product={product} />
        ))}
      </div>

      <!-- View Complete Wholesale Catalog Button Matching Reference -->
      <div class="catalog-view-all-wrap">
        <a href="/catalogue" class="btn-view-complete-catalog">
          <span>View Complete Wholesale Catalog</span>
          <span class="catalog-btn-arrow">&rarr;</span>
        </a>
      </div>
    </div>
  </section>


  <!-- Custom OEM / ODM & Private Label Sourcing Dark Bento Section -->
  <section class="section-custom-oem">
    <div class="container-apparel">
      <div class="oem-bento-card">
        <!-- Left Column: Content & CTAs -->
        <div class="oem-left-col">
