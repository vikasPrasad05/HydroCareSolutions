  // ==========================================
  const offerActiveSwitch = document.getElementById('offerActiveSwitch') as HTMLInputElement;
  const offerStatusNotice = document.getElementById('offerStatusNotice');
  const offerStatusNoticeText = document.getElementById('offerStatusNoticeText');
  const offerTitleInput = document.getElementById('offerTitleInput') as HTMLInputElement;
  const offerDescInput = document.getElementById('offerDescInput') as HTMLInputElement;
  const offerLinkInput = document.getElementById('offerLinkInput') as HTMLInputElement;
  const offerButtonTextInput = document.getElementById('offerButtonTextInput') as HTMLInputElement;
