    btn.addEventListener('click', async (e) => {
      e.stopPropagation();
      const id = btn.getAttribute('data-id');
      const row = btn.closest('tr');
      if (!id || !row) return;

      const currentVis = (row.getAttribute('data-visibility') || 'hidden').toLowerCase();
      const newVis = currentVis === 'hidden' ? 'Visible' : 'Hidden';

      try {
        const res = await fetch(`/api/reviews/${id}`, {
          method: 'PATCH',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ visibility: newVis })
        });
        if (res.ok) {
          row.setAttribute('data-visibility', newVis.toLowerCase());
          const visPill = row.querySelector('.review-visibility-pill');
          if (visPill) {
            visPill.className = `review-visibility-pill ${newVis.toLowerCase()}`;
            visPill.textContent = newVis;
          }
          btn.textContent = newVis === 'Hidden' ? '👁 Show on Site' : '🚫 Hide from Site';
          const menu = btn.closest<HTMLElement>('.review-action-dropdown');
          if (menu) menu.style.display = 'none';
          showToast(`Visibility set to ${newVis}`);
        } else {
          showToast('Failed to update visibility', true);
        }
      } catch (err: any) {
        showToast(err.message || 'Error updating visibility', true);
      }
    });
  });

  // Toggle Status action
  document.querySelectorAll<HTMLElement>('.toggle-status-btn').forEach(btn => {
    btn.addEventListener('click', async (e) => {
      e.stopPropagation();
      const id = btn.getAttribute('data-id');
      const row = btn.closest('tr');
      if (!id || !row) return;

      const currentStatus = (row.getAttribute('data-status') || 'approved').toLowerCase();
