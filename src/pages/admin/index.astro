        </div>

        <!-- Card 1: Current Offer Configuration -->
        <div class="offers-config-card">
          <div class="offers-card-header">
            <div class="offers-card-title-row">
              <svg class="offer-tag-icon" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"></path>
                <line x1="7" y1="7" x2="7.01" y2="7"></line>
              </svg>
              <h2 class="offers-card-title">Current Offer</h2>
            </div>
            <p class="offers-card-desc">Configure the popup offer that visitors will see once per session</p>
          </div>

          <!-- Toggle Box -->
          <div class="offer-toggle-box">
            <div class="offer-toggle-left">
              <h3 class="offer-toggle-title">Offer Active</h3>
              <p class="offer-toggle-sub">When enabled, visitors will see this offer popup once per session</p>
            </div>
            <label class="switch-toggle" for="offerActiveSwitch">
              <input type="checkbox" id="offerActiveSwitch" checked={currentOffer.active} />
              <span class="slider-round"></span>
            </label>
          </div>

          <!-- Status Notice Banner -->
          <div class={`offer-status-notice ${currentOffer.active ? 'active' : ''}`} id="offerStatusNotice">
            <span class="status-dot-bullet" id="statusDotBullet"></span>
            <span id="offerStatusNoticeText">
              {currentOffer.active ? '• Offer is currently active' : '• Offer is currently disabled'}
            </span>
          </div>

          <form id="offerConfigForm" class="offer-form-layout">
            <!-- Field: Title -->
            <div class="offer-form-group">
              <label class="offer-label" for="offerTitleInput">Offer Title *</label>
              <input 
                type="text" 
                id="offerTitleInput" 
                class="offer-input-field" 
                value={currentOffer.title || '10% off on tshirt bulk order'} 
                required 
              />
              <span class="offer-field-hint">The main headline of your offer</span>
            </div>

            <!-- Field: Description -->
            <div class="offer-form-group">
              <label class="offer-label" for="offerDescInput">Offer Description *</label>
              <input 
                type="text" 
                id="offerDescInput" 
                class="offer-input-field" 
                value={currentOffer.description || '10% off on tshirt bulk order above 5000 quant'} 
                required 
              />
              <span class="offer-field-hint">Details about the offer</span>
            </div>

            <!-- Grid 2-cols: Link URL & Button Text -->
            <div class="offer-form-grid-2">
              <div class="offer-form-group">
                <label class="offer-label" for="offerLinkInput">Link URL (Optional)</label>
                <input 
                  type="text" 
                  id="offerLinkInput" 
                  class="offer-input-field" 
                  placeholder="e.g., /enquiry or /catalogue" 
                  value={currentOffer.linkUrl || ''} 
                />
                <span class="offer-field-hint">Page to redirect when user clicks the offer button</span>
              </div>

              <div class="offer-form-group">
                <label class="offer-label" for="offerButtonTextInput">Button Text (Optional)</label>
                <input 
                  type="text" 
                  id="offerButtonTextInput" 
                  class="offer-input-field" 
                  placeholder="Claim offer" 
                  value={currentOffer.buttonText || 'Claim offer'} 
                />
                <span class="offer-field-hint">Text for the call-to-action button (default: "View Offer")</span>
              </div>
            </div>

            <!-- Save Offer Button -->
            <div class="offer-form-actions">
              <button type="submit" class="btn-save-offer" id="saveOfferBtn">
                <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"></path>
                  <polyline points="17 21 17 13 7 13 7 21"></polyline>
                  <polyline points="7 3 7 8 15 8"></polyline>
                </svg>
                <span>Save Offer</span>
              </button>
            </div>
          </form>
        </div>

        <!-- Card 2: Preview Card -->
        <div class="offers-preview-card">
          <h2 class="preview-card-title">Preview</h2>
          <p class="preview-card-sub">This is how the offer will appear to visitors</p>

          <div class="offer-live-banner" id="offerLiveBanner">
            <div class="banner-tag-badge">
              <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"></path>
                <line x1="7" y1="7" x2="7.01" y2="7"></line>
              </svg>
            </div>
            <div class="banner-content">
              <h3 class="banner-headline" id="previewHeadline">
                {currentOffer.title || '10% off on tshirt bulk order'}
              </h3>
              <p class="banner-subtext" id="previewSubtext">
                {currentOffer.description || '10% off on tshirt bulk order above 5000 quant'}
              </p>
            </div>
          </div>
        </div>
      </section>

