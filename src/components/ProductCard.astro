---
import type { Product } from '../lib/types';

interface Props {
  product: Product;
}

const { product } = Astro.props;
---

<div class="product-wholesale-card group">
  <!-- Image Container with Dark Pill Badge (Exact 190px height matching AGS visual cards) -->
  <div class="card-media-wrap">
    <a href={`/products/${product.slug}`} class="media-link">
      <img 
        src={product.image_url} 
        alt={product.name} 
        loading="lazy" 
        class="card-img"
      />
    </a>
  </div>

  <!-- Card Body Content -->
  <div class="card-body">
    <!-- Product Title (Standardized 2-line height) -->
    <h3 class="card-product-title">
      <a href={`/products/${product.slug}`} title={product.name}>
        {product.name}
      </a>
    </h3>

    <!-- Product Description (Standardized 3-line height) -->
    <p class="card-product-desc">
      {product.short_description || 'High-performance fresh packaging and absorption solutions engineered to international food-contact safety standards.'}
    </p>

    <!-- Color Variants Strip -->
    <div class="card-colors-strip" title="Available in 5 certified food-grade colors">
      <span class="dot-swatch" style="background:#FFFFFF; border:1px solid #CBD5E1;"></span>
      <span class="dot-swatch" style="background:#0F172A;"></span>
      <span class="dot-swatch" style="background:#2563EB;"></span>
      <span class="dot-swatch" style="background:#F472B6;"></span>
      <span class="dot-swatch" style="background:#EAB308;"></span>
      <span class="dot-label">5 Color Variants</span>
    </div>

    <!-- Bottom Action Buttons Matching Visual Demo Cards -->
    <div class="card-btn-group">
      <a href={`/products/${product.slug}`} class="btn-card-outline">
        View Specs
      </a>
      <a 
        href={`/enquiry?product=${encodeURIComponent(product.name)}`}
        class="btn-card-primary"
      >
        Sample & Quote
      </a>
    </div>
  </div>
</div>

<style>
  .product-wholesale-card {
    background: #FFFFFF;
    border: 1px solid #E2E8F0;
    border-radius: 8px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    height: 100%;
    box-shadow: 0 2px 8px rgba(15, 23, 42, 0.04);
  }

  /* Exact 190px Image Area Matching AGS Demo Cards */
  .card-media-wrap {
    position: relative;
    width: 100%;
    height: 190px;
    background: #F8FAFC;
    overflow: hidden;
  }

  .media-link {
    display: block;
    width: 100%;
    height: 100%;
  }

  .card-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }


  /* Card Body */
  .card-body {
    padding: 16px;
    display: flex;
    flex-direction: column;
    flex-grow: 1;
  }

  /* Product Title (Consistent 40px min-height across all cards) */
  .card-product-title {
    font-family: var(--font-sans, 'Inter', system-ui, sans-serif);
    font-size: 14.5px;
    font-weight: 700;
    line-height: 1.35;
    margin: 0 0 6px;
    min-height: 40px;
    display: flex;
    align-items: flex-start;
  }

  .card-product-title a {
    color: #0F172A;
    text-decoration: none;
    transition: color 0.15s ease;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .card-product-title a:hover {
    color: #2563EB;
  }

  /* Product Description (Consistent 56px min-height for uniform button alignment) */
  .card-product-desc {
    font-family: var(--font-sans, 'Inter', system-ui, sans-serif);
    font-size: 12.5px;
    color: #64748B;
    line-height: 1.5;
    margin: 0 0 14px;
    min-height: 56px;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
    flex-grow: 1;
  }

  /* Color Variants Strip */
  .card-colors-strip {
    display: flex;
    align-items: center;
    gap: 5px;
    margin-bottom: 12px;
  }

  .dot-swatch {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    display: inline-block;
    flex-shrink: 0;
    box-shadow: 0 1px 2px rgba(0,0,0,0.1);
  }

  .dot-label {
    font-size: 11px;
    font-weight: 600;
    color: #64748B;
    margin-left: 3px;
  }

  /* Action Buttons */
  .card-btn-group {
    display: flex;
    gap: 8px;
    margin-top: auto;
  }

  .btn-card-outline {
    flex: 1;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 8px 10px;
    font-family: 'Inter', system-ui, sans-serif;
    font-size: 13px;
    font-weight: 600;
    color: #2563EB;
    background: #FFFFFF;
    border: 1px solid #CBD5E1;
    border-radius: 6px;
    text-decoration: none;
    text-align: center;
    white-space: nowrap;
    transition: all 0.15s ease;
  }

  .btn-card-outline:hover {
    background: #EFF6FF;
    border-color: #BFDBFE;
    color: #1D4ED8;
  }

  .btn-card-primary {
    flex: 1;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 8px 12px;
    font-family: 'Inter', system-ui, sans-serif;
    font-size: 13px;
    font-weight: 700;
    color: #FFFFFF;
    background: #800000;
    border: none;
    border-radius: 6px;
    text-decoration: none;
    text-align: center;
    white-space: nowrap;
    transition: all 0.15s ease;
  }

  .btn-card-primary:hover {
    background: #660000;
  }
</style>
