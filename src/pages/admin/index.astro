    const qtyDisplay = `${Number(inq.quantity || 100).toLocaleString()} units`;
    const inqJsonEscaped = escapeHtml(JSON.stringify(inq));

    return `
      <tr 
        class="enquiry-row-item ${isNew ? 'row-just-added' : ''}" 
        data-id="${escapeHtml(inq.id)}"
