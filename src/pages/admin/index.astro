                    <span class={`review-status-pill ${rev.status.toLowerCase()}`}>
                      {rev.status}
                    </span>
                  </td>
                  <td>
                    <span class={`review-visibility-pill ${rev.visibility.toLowerCase()}`}>
                      {rev.visibility}
                    </span>
                  </td>
                  <td style="text-align: right; position: relative;">
                    <button type="button" class="action-dots-btn" data-id={rev.id} title="Actions">
                      <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor">
