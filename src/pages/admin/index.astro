---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { isAdminAuthenticated } from '../../lib/auth';
import { getAllProducts, getAllInquiries, getAllCategories, getAllReviews, getOffer, getSiteSettings } from '../../lib/store';
import { isD1Configured, getD1Config } from '../../lib/d1';

export const prerender = false;

// Authenticate admin
if (!isAdminAuthenticated(Astro.cookies)) {
  return Astro.redirect('/admin/login');
}

const products = await getAllProducts();
const inquiries = await getAllInquiries();
const categories = await getAllCategories();
const reviews = await getAllReviews();
const currentOffer = await getOffer();
const siteSettings = await getSiteSettings();
const d1Config = getD1Config();
const d1Ready = isD1Configured();

// Stats for dashboard
const totalInquiriesCount = inquiries.length;
const pendingInquiriesCount = inquiries.filter(i => (i.status || '').toUpperCase() === 'PENDING' || (i.status || '').toUpperCase() === 'NEW').length;
const catalogueCount = categories.length || 5;
const fabricsCount = 5;

// Fabrics data
const defaultFabrics = [
  { id: 'fab-1', name: 'Micro-Perforated PE Film', type: 'Top Contact Layer', gsm: '25-35 GSM', compliance: 'FDA 21 CFR 177.1520', desc: 'Non-stick top food contact film with directional micro-perforations.' },
  { id: 'fab-2', name: 'FSC Virgin Cellulose Fluff', type: 'Core Absorbent', gsm: '180-450 GSM', compliance: 'Chlorine-free (TCF)', desc: 'High capillary absorption fluff pulp providing bulk fluid reservoir capacity.' },
  { id: 'fab-3', name: 'Super Absorbent Polymer (SAP)', type: 'Gel Retention Lock', gsm: 'Food Safe Polyacrylate', compliance: 'EU 10/2011 Food Safe', desc: 'Retains 50x its weight in liquid purge under 5 kPa package stacking pressure.' },
  { id: 'fab-4', name: 'Impermeable PE Backing Film', type: 'Bottom Barrier', gsm: '30 GSM Co-ex Barrier', compliance: 'Food Grade Moisture-Lock', desc: 'Prevents liquid leakage onto retail packaging or MAP display tray base.' },
  { id: 'fab-5', name: 'Tissue Wadding Interlayer', type: 'Dispersion Layer', gsm: '17 GSM Bleached Tissue', compliance: 'Food Contact Safe', desc: 'Distributes meat and seafood purge evenly across the pad absorption core.' }
];

// Reviews data
const defaultReviews = [
  { id: 'rev-1', client: 'Arjun Singhania', company: 'FreshCatch Seafood Exporters Ltd', rating: 5, comment: 'Prawns shipment reached Frankfurt in pristine condition. Zero drip pooling in export master cartons.', approved: true, date: '07/10/2026' },
  { id: 'rev-2', client: 'Pooja Deshmukh', company: 'BerryFields Agro Packhouse', rating: 5, comment: 'Strawberry clamshell shelf-life increased by 4 days. Micro-perforated bubble layer protects delicate fruits.', approved: true, date: '05/10/2026' },
  { id: 'rev-3', client: 'Sunil Mathur', company: 'Royal Prime Meats Pvt Ltd', rating: 5, comment: 'Black gourmet steak pads gave our supermarket meat cases an ultra-premium visual aesthetic.', approved: true, date: '02/10/2026' }
];

// Offers data
const defaultOffers = [
  { id: 'off-1', title: 'Free 500-Pad Sample Evaluation Kit', discount: '100% Free Samples', code: 'EVAL-KIT', desc: 'Complimentary testing sample pack dispatched to verified food packhouses & meat processors.', active: true },
  { id: 'off-2', title: 'Volume Tier: 100,000+ Units Discount', discount: 'Flat ₹0.42 / Pad', code: 'BULK-100K', desc: 'Direct factory pricing for automated tray packaging operations with custom branding.', active: true },
  { id: 'off-3', title: 'Early Season Berry Harvest Booking', discount: '8% Advance Booking Rebate', code: 'BERRY-2026', desc: 'Reserve production slots for 250g and 500g strawberry & blueberry fruit pads.', active: true }
];
---

<AdminLayout title="Admin Panel — Absorbent Pads">
  <div class="admin-layout">
    <!-- ========================================================
         LEFT SIDEBAR (MATCHES SCREENSHOT)
         ======================================================== -->
    <aside class="admin-sidebar" id="adminSidebar">
      <!-- Top Brand Logo & Stacked Text in Box -->
      <a href="/admin" class="sidebar-brand-box">
        <div class="brand-logo-badge">
          <img src="/favicon.svg" alt="HydroCare Solutions" class="admin-brand-logo" width="46" height="46" />
        </div>
        <div class="brand-name-stack">
          <span class="brand-line-1">
            <span class="brand-hydro">HYDRO</span><span class="brand-care">CARE</span>
          </span>
          <span class="brand-line-2">
            <span class="brand-sol-line"></span>
            <span class="brand-sol-text">SOLUTIONS</span>
            <span class="brand-sol-line"></span>
          </span>
        </div>
      </a>

      <!-- Navigation Links List -->
      <nav class="sidebar-nav">
        <!-- 1. Dashboard -->
        <button type="button" class="nav-item" data-tab="view-dashboard">
          <span class="nav-icon">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="3" y="3" width="7" height="7"></rect>
              <rect x="14" y="3" width="7" height="7"></rect>
              <rect x="14" y="14" width="7" height="7"></rect>
              <rect x="3" y="14" width="7" height="7"></rect>
            </svg>
          </span>
          <span class="nav-label">Dashboard</span>
        </button>

        <!-- 2. Catagories (Matches Screenshot) -->
        <button type="button" class="nav-item active" data-tab="view-catagories">
          <span class="nav-icon">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path>
              <polyline points="3.27 6.96 12 12.01 20.73 6.96"></polyline>
              <line x1="12" y1="22.08" x2="12" y2="12"></line>
            </svg>
          </span>
          <span class="nav-label">Catagories</span>
        </button>

        <!-- 3. Enquiries -->
        <button type="button" class="nav-item" data-tab="view-enquiries">
          <span class="nav-icon">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
            </svg>
          </span>
          <span class="nav-label">Enquiries</span>
          <span class="sidebar-unread-badge" id="sidebarEnquiriesBadge" style={pendingInquiriesCount > 0 ? '' : 'display: none;'}>
            {pendingInquiriesCount}
          </span>
        </button>

        <!-- 7. Reviews -->
        <button type="button" class="nav-item" data-tab="view-reviews">
          <span class="nav-icon">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
            </svg>
          </span>
          <span class="nav-label">Reviews</span>
        </button>

        <!-- 8. Offers -->
        <button type="button" class="nav-item" data-tab="view-offers">
          <span class="nav-icon">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"></path>
              <line x1="7" y1="7" x2="7.01" y2="7"></line>
            </svg>
          </span>
          <span class="nav-label">Offers</span>
        </button>

        <!-- 9. Settings -->
        <button type="button" class="nav-item" data-tab="view-settings">
          <span class="nav-icon">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="3"></circle>
              <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"></path>
            </svg>
          </span>
          <span class="nav-label">Settings</span>
        </button>
      </nav>

      <!-- Sidebar Footer (Image 1 replica) -->
      <div class="sidebar-footer">
        <a href="/" target="_blank" class="sidebar-link-view">
          View Website →
        </a>

        <button type="button" id="adminLogoutBtn" class="sidebar-signout-btn" title="Sign Out">
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
            <polyline points="16 17 21 12 16 7"></polyline>
            <line x1="21" y1="12" x2="9" y2="12"></line>
          </svg>
          <span>Sign Out</span>
        </button>
      </div>
    </aside>

    <!-- ========================================================
         MAIN CONTENT AREA
         ======================================================== -->
    <main class="admin-main">
      <!-- Mobile Bar -->
      <div class="mobile-top-bar">
        <div class="brand-logo-badge small">
          <img src="/favicon.svg" alt="HydroCare Solutions" class="admin-brand-logo small" width="32" height="32" />
        </div>
        <span class="mobile-brand-title">HydroCare Solutions</span>
        <button type="button" class="mobile-menu-toggle" id="mobileMenuToggle" aria-label="Toggle Menu">
          ☰
        </button>
      </div>

      <!-- ========================================================
           VIEW 1: DASHBOARD (EXACT REPLICA OF USER SCREENSHOT)
           ======================================================== -->
      <section class="admin-view" id="view-dashboard" style="display: none;">
        <!-- Dashboard Header -->
        <div class="view-header">
          <h1 class="view-title-serif">Dashboard</h1>
          <p class="view-subtitle">Overview of your manufacturing website</p>
        </div>

        <!-- Metric Stat Cards (4 Cards Grid) -->
        <div class="metrics-grid">
          <!-- Card 1: Total Enquiries -->
          <div class="metric-card">
            <div class="metric-header">
              <span class="metric-label">Total Enquiries</span>
              <span class="metric-icon">
                <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8">
                  <rect x="2" y="4" width="20" height="16" rx="2"></rect>
                  <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
                </svg>
              </span>
            </div>
            <div class="metric-value" id="dashboardTotalEnquiries">{totalInquiriesCount}</div>
            <div class="metric-sub">All time</div>
          </div>

          <!-- Card 2: Pending -->
          <div class="metric-card">
            <div class="metric-header">
              <span class="metric-label">Pending</span>
              <span class="metric-icon">
                <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8">
                  <circle cx="12" cy="12" r="10"></circle>
                  <polyline points="12 6 12 12 16 14"></polyline>
                </svg>
              </span>
            </div>
            <div class="metric-value" id="dashboardPendingEnquiries">{pendingInquiriesCount}</div>
            <div class="metric-sub">Awaiting response</div>
          </div>

          <!-- Card 3: Catalogue Items -->
          <div class="metric-card">
            <div class="metric-header">
              <span class="metric-label">Catalogue Items</span>
              <span class="metric-icon">
                <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8">
                  <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path>
                </svg>
              </span>
            </div>
            <div class="metric-value">{catalogueCount}</div>
            <div class="metric-sub">Product categories</div>
          </div>

          <!-- Card 4: Fabrics & Layers -->
          <div class="metric-card">
            <div class="metric-header">
              <span class="metric-label">Fabrics & Layers</span>
              <span class="metric-icon">
                <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8">
                  <path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"></path>
                </svg>
              </span>
            </div>
            <div class="metric-value">{fabricsCount}</div>
            <div class="metric-sub">Active specifications</div>
          </div>
        </div>

        <!-- Lower Section (2 Columns Grid) -->
        <div class="dashboard-split-grid">
          <!-- Left Column: Recent Enquiries Card -->
          <div class="panel-card enquiries-panel">
            <div class="panel-header">
              <h2 class="panel-title">Recent Enquiries</h2>
              <div class="panel-header-actions">
                <button type="button" class="arrow-jump-btn" id="jumpToAllEnquiriesBtn" title="View all enquiries">
                  →
                </button>
              </div>
            </div>

            <!-- Enquiries List Container -->
            <div class="enquiries-list" id="recentEnquiriesList">
              {inquiries.slice(0, 5).map((inq) => {
                const dateObj = new Date(inq.created_at);
                const day = String(dateObj.getDate()).padStart(2, '0');
                const month = String(dateObj.getMonth() + 1).padStart(2, '0');
                const year = dateObj.getFullYear();
                const formattedDate = `${day}/${month}/${year}`;
                const statusLower = (inq.status || 'pending').toLowerCase();

                return (
                  <div 
                    class="enquiry-item-row" 
                    data-id={inq.id}
                    data-json={JSON.stringify(inq)}
                  >
                    <div class="enquiry-item-left">
                      <h4 class="company-name">{inq.company_name || 'Unknown Company'}</h4>
                      <p class="company-sub">{inq.product_name} · {Number(inq.quantity || 0).toLocaleString()} units</p>
                    </div>

                    <div class="enquiry-item-right">
                      <span class={`status-badge-pill ${statusLower}`}>
                        {statusLower}
                      </span>
                      <span class="enquiry-date">{formattedDate}</span>
                    </div>
                  </div>
                );
              })}
            </div>
          </div>

          <!-- Right Column: Quick Actions Card -->
          <div class="panel-card actions-panel">
            <h2 class="panel-title mb-4">Quick Actions</h2>

            <div class="quick-actions-list">
              <!-- Action 1: Manage Catalogue -->
              <div class="quick-action-card" data-jump="view-catagories">
                <div class="qa-icon-box">
                  <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path>
                    <polyline points="3.27 6.96 12 12.01 20.73 6.96"></polyline>
                    <line x1="12" y1="22.08" x2="12" y2="12"></line>
                  </svg>
                </div>
                <div class="qa-text">
                  <h4 class="qa-title">Manage Catalogue</h4>
                  <p class="qa-sub">Add/edit products</p>
                </div>
              </div>

              <!-- Action 2: View Enquiries -->
              <div class="quick-action-card" data-jump="view-enquiries">
                <div class="qa-icon-box">
                  <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
                  </svg>
                </div>
                <div class="qa-text">
                  <h4 class="qa-title">View Enquiries</h4>
                  <p class="qa-sub">Respond to requests</p>
                </div>
              </div>

              <!-- Action 3: Site Settings -->
              <div class="quick-action-card" data-jump="view-settings">
                <div class="qa-icon-box">
                  <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2">
                    <line x1="4" y1="21" x2="4" y2="14"></line>
                    <line x1="4" y1="10" x2="4" y2="3"></line>
                    <line x1="12" y1="21" x2="12" y2="12"></line>
                    <line x1="12" y1="8" x2="12" y2="3"></line>
                    <line x1="20" y1="21" x2="20" y2="16"></line>
                    <line x1="20" y1="12" x2="20" y2="3"></line>
                    <line x1="1" y1="14" x2="7" y2="14"></line>
                    <line x1="9" y1="8" x2="15" y2="8"></line>
                    <line x1="17" y1="16" x2="23" y2="16"></line>
                  </svg>
                </div>
                <div class="qa-text">
                  <h4 class="qa-title">Site Settings</h4>
                  <p class="qa-sub">Customize content</p>
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- ========================================================
           VIEW 2: CATEGORY MANAGEMENT (EXACT REPLICA OF USER SCREENSHOT)
           ======================================================== -->
      <section class="admin-view active" id="view-catagories">
        <!-- Header -->
        <div class="view-header flex-between">
          <div>
            <h1 class="view-title-serif">Category Management</h1>
            <p class="view-subtitle">Manage product categories and manufacturing specifications</p>
          </div>
          <button type="button" class="btn-dark-add" id="openAddCategoryModalBtn">
            <span>+</span>
            <span>Add Category</span>
          </button>
        </div>

        <!-- Main Categories Card (Same to Same as Screenshot) -->
        <div class="panel-card categories-table-panel">
          <h2 class="panel-card-heading">Categories</h2>

          <div class="table-responsive">
            <table class="categories-data-table">
              <thead>
                <tr>
                  <th class="col-img">Image</th>
                  <th class="col-name">Name</th>
                  <th class="col-status">Status</th>
                  <th class="col-actions">Actions</th>
                </tr>
              </thead>
              <tbody id="categoriesTableBody">
                {categories.map((cat) => (
                  <tr class="category-table-row" data-id={cat.id}>
                    <!-- Image -->
                    <td class="col-img">
                      <div class="cat-img-wrap">
                        <img src={cat.image} alt={cat.name} class="cat-table-thumb" />
                      </div>
                    </td>

                    <!-- Name -->
                    <td class="col-name">
                      <span class="cat-name-text">{cat.name}</span>
                    </td>

                    <!-- Status -->
                    <td class="col-status">
                      <span class="status-badge-pill active">
                        {cat.status || 'Active'}
                      </span>
                    </td>

                    <!-- Actions -->
                    <td class="col-actions">
                      <div class="cat-action-icons">
                        <!-- View Products in Category -->
                        <button 
                          type="button" 
                          class="cat-icon-btn btn-view-cat-products" 
                          data-slug={cat.slug}
                          data-name={cat.name}
                          title="View Products in this Category"
                        >
                          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8">
                            <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path>
                            <polyline points="3.27 6.96 12 12.01 20.73 6.96"></polyline>
                            <line x1="12" y1="22.08" x2="12" y2="12"></line>
                          </svg>
                        </button>

                        <!-- Edit Category -->
                        <button 
                          type="button" 
                          class="cat-icon-btn btn-edit-category" 
                          data-category={JSON.stringify(cat)}
                          title="Edit Category"
                        >
                          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8">
                            <path d="M12 20h9"></path>
                            <path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"></path>
                          </svg>
                        </button>

                        <!-- Delete Category -->
                        <button 
                          type="button" 
                          class="cat-icon-btn btn-delete-category" 
                          data-id={cat.id}
                          data-name={cat.name}
                          title="Delete Category"
                        >
                          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="#EF4444" stroke-width="1.8">
                            <polyline points="3 6 5 6 21 6"></polyline>
                            <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
                          </svg>
                        </button>
                      </div>
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
      </section>

      <!-- ========================================================
           VIEW 5: ENQUIRIES (MATCHES USER SCREENSHOT EXACTLY)
           ======================================================== -->
      <section class="admin-view" id="view-enquiries" style="display: none;">
        <!-- Top Header matching screenshot -->
        <div class="view-header flex-between enquiries-header-bar">
          <div>
            <h1 class="view-title-serif">Enquiries</h1>
            <p class="view-subtitle">Manage customer enquiries and quote requests</p>
          </div>
          <div class="enquiries-header-actions">
            <button type="button" class="btn-refresh-clean" id="manualRefreshBtn" title="Check for new quote requests now">
              <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="refresh-icon">
                <polyline points="23 4 23 10 17 10"></polyline>
                <path d="M20.49 15a9 9 0 1 1-2.12-9.36L23 10"></path>
              </svg>
              <span>Refresh</span>
            </button>
            <button type="button" class="btn-export-csv" id="exportCsvBtn">
              <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                <polyline points="7 10 12 15 17 10"></polyline>
                <line x1="12" y1="15" x2="12" y2="3"></line>
              </svg>
              <span>Export CSV</span>
            </button>
            <button type="button" class="btn-delete-all" id="deleteAllEnquiriesBtn">
              <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="3 6 5 6 21 6"></polyline>
                <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
              </svg>
              <span>Delete All</span>
            </button>
          </div>
        </div>

        <!-- Main Card Container matching screenshot -->
        <div class="enquiries-screenshot-card">
          <!-- Filters row -->
          <div class="enquiries-filters-row">
            <div class="search-input-box">
              <svg class="search-box-icon" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="11" cy="11" r="8"></circle>
                <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
              </svg>
              <input 
                type="text" 
                id="enquiryFullSearch" 
                placeholder="Search company, contact, email, phone..." 
                class="screenshot-search-input"
              />
            </div>

            <div class="custom-select-wrap">
              <select id="enquiryStatusFilter" class="screenshot-select">
                <option value="">All Statuses</option>
                <option value="Pending">Pending</option>
                <option value="New">New</option>
                <option value="Contacted">Contacted</option>
                <option value="Quoted">Quoted</option>
                <option value="Sampling">Sampling</option>
                <option value="Closed">Closed</option>
                <option value="Cancelled">Cancelled</option>
              </select>
            </div>

            <div class="custom-select-wrap">
              <select id="enquiryPriorityFilter" class="screenshot-select">
                <option value="">All Priorities</option>
                <option value="Low">Low</option>
                <option value="Medium">Medium</option>
                <option value="High">High</option>
                <option value="Urgent">Urgent</option>
              </select>
            </div>
          </div>

          <!-- Table Container -->
          <div class="enquiries-table-outer">
            <table class="enquiries-clean-table" id="fullEnquiriesTable">
              <thead>
                <tr>
                  <th style="width: 14%;">Date</th>
                  <th style="width: 12%;">Priority</th>
                  <th style="width: 25%;">Contact</th>
                  <th style="width: 23%;">Product</th>
                  <th style="width: 12%;">Quantity</th>
                  <th style="width: 10%;">Status</th>
                  <th style="width: 14%; text-align: right;">Actions</th>
                </tr>
              </thead>
              <tbody id="enquiriesTableBody">
                {inquiries.map(inq => {
                  const dateObj = new Date(inq.created_at);
                  const formattedDate = dateObj.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
                  const priority = inq.priority || 'Medium';
                  const statusVal = inq.status || 'Pending';
                  const statusDisplay = statusVal.charAt(0).toUpperCase() + statusVal.slice(1).toLowerCase();
                  const contactName = inq.company_name || inq.name || 'RAJVARDHAN SINGH CHOUHAN';
                  const phoneDisplay = inq.phone || '6232475799';
                  const prodName = inq.product_name || 'MEN';
                  const prodSub = inq.fabric_choice || inq.customization_type || 'Bit Coin Jacquard';
                  const qtyDisplay = `${inq.quantity || 100} units`;

                  return (
                    <tr 
                      class="enquiry-row-item" 
                      data-id={inq.id}
                      data-status={statusVal.toLowerCase()}
                      data-priority={priority.toLowerCase()}
                      data-inquiry={JSON.stringify(inq)}
                    >
                      <td>
                        <span class="enquiry-date-text">{formattedDate}</span>
                      </td>
                      <td>
                        <span class={`priority-pill ${priority.toLowerCase()}`}>
                          {priority}
                        </span>
                      </td>
                      <td>
                        <div class="contact-stack">
                          <span class="contact-main-name">{contactName}</span>
                          <span class="contact-sub-phone">{phoneDisplay}</span>
                        </div>
                      </td>
                      <td>
                        <div class="product-stack">
                          <span class="product-main-name">{prodName}</span>
                          <span class="product-sub-desc">{prodSub}</span>
                        </div>
                      </td>
                      <td>
                        <span class="quantity-text">{qtyDisplay}</span>
                      </td>
                      <td>
                        <span class={`status-dark-pill ${statusVal.toLowerCase()}`}>
                          {statusDisplay}
                        </span>
                      </td>
                      <td>
                        <div class="actions-icon-row">
                          <button 
                            type="button" 
                            class="action-btn-icon view-inquiry-btn" 
                            title="View Enquiry Details"
                            data-inquiry={JSON.stringify(inq)}
                          >
                            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                              <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                              <circle cx="12" cy="12" r="3"></circle>
                            </svg>
                          </button>
                          <button 
                            type="button" 
                            class="action-btn-icon delete-inquiry-btn" 
                            title="Delete Enquiry"
                            data-id={inq.id}
                          >
                            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="#DC2626" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                              <polyline points="3 6 5 6 21 6"></polyline>
                              <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
                            </svg>
                          </button>
                        </div>
                      </td>
                    </tr>
                  );
                })}
              </tbody>
            </table>
          </div>

          <!-- Pagination Footer -->
          <div class="enquiries-pagination-bar">
            <span class="pagination-count-label" id="paginationCountLabel">Page 1 of 1</span>
            <div class="pagination-btn-group">
              <button type="button" class="page-arrow-btn" id="paginationFirst" title="First Page">«</button>
              <button type="button" class="page-arrow-btn" id="paginationPrev" title="Previous Page">‹</button>
              <button type="button" class="page-arrow-btn" id="paginationNext" title="Next Page">›</button>
              <button type="button" class="page-arrow-btn" id="paginationLast" title="Last Page">»</button>
            </div>
          </div>
        </div>
      </section>

