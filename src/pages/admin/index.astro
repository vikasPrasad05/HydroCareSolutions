          </span>
        </td>
        <td>
          <div class="contact-stack">
            <span class="contact-main-name">${escapeHtml(contactName)}</span>
            <span class="contact-sub-phone">${escapeHtml(phoneDisplay)}</span>
          </div>
        </td>
        <td>
          <div class="product-stack">
            <span class="product-main-name">${escapeHtml(prodName)}</span>
            <span class="product-sub-desc">${escapeHtml(prodSub)}</span>
          </div>
        </td>
        <td>
          <span class="quantity-text">${escapeHtml(qtyDisplay)}</span>
        </td>
        <td>
          <span class="status-dark-pill ${escapeHtml(statusVal.toLowerCase())}">
            ${escapeHtml(statusDisplay)}
          </span>
        </td>
        <td>
          <div class="actions-icon-row">
            <button 
              type="button" 
              class="action-btn-icon view-inquiry-btn" 
              title="View Enquiry Details"
              data-inquiry="${inqJsonEscaped}"
            >
              <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8z"></path>
                <circle cx="12" cy="12" r="3"></circle>
              </svg>
            </button>
            <button 
              type="button" 
