<script>
  // Tab Switching Logic
  const navItems = document.querySelectorAll<HTMLButtonElement>('.sidebar-nav .nav-item');
  const views = document.querySelectorAll<HTMLElement>('.admin-view');
  const toast = document.getElementById('adminToast');

  function showToast(message: string, isError = false) {
    if (!toast) return;
    toast.textContent = message;
    toast.className = `admin-toast visible ${isError ? 'error' : 'success'}`;
    setTimeout(() => {
      toast.className = 'admin-toast';
    }, 3200);
  }

  function switchTab(targetViewId: string) {
    views.forEach(v => {
      v.style.display = 'none';
      v.classList.remove('active');
    });

    const activeView = document.getElementById(targetViewId);
    if (activeView) {
      activeView.style.display = 'block';
      activeView.classList.add('active');
    }

    navItems.forEach(item => {
      if (item.getAttribute('data-tab') === targetViewId) {
        item.classList.add('active');
      } else {
        item.classList.remove('active');
      }
    });

    // Close mobile menu if open
    document.getElementById('adminSidebar')?.classList.remove('open');
    window.scrollTo({ top: 0, behavior: 'smooth' });

    // Update URL hash
    window.location.hash = targetViewId;

    if (targetViewId === 'view-enquiries' || targetViewId === 'view-dashboard') {
      if (typeof checkAndUpdateInquiries === 'function') {
        checkAndUpdateInquiries(false);
      }
    }
  }

  navItems.forEach(btn => {
    btn.addEventListener('click', () => {
      const target = btn.getAttribute('data-tab');
      if (target) switchTab(target);
    });
  });

  // Check URL hash on load - default to view-catagories
  if (window.location.hash) {
    const hashTarget = window.location.hash.replace('#', '');
    if (document.getElementById(hashTarget)) {
      switchTab(hashTarget);
    } else {
      switchTab('view-catagories');
    }
  } else {
    switchTab('view-catagories');
  }

  // Quick Action Jump buttons
  document.querySelectorAll<HTMLElement>('.quick-action-card[data-jump]').forEach(card => {
    card.addEventListener('click', () => {
      const target = card.getAttribute('data-jump');
      if (target) switchTab(target);
    });
  });

  // Toggle Enquiries vs Designs in Recent Enquiries Panel
  const toggleEnqBtn = document.getElementById('toggleEnquiriesTabBtn');
  const toggleDesBtn = document.getElementById('toggleDesignsTabBtn');
  const recentEnqList = document.getElementById('recentEnquiriesList');
  const recentDesList = document.getElementById('recentDesignsList');

  toggleEnqBtn?.addEventListener('click', () => {
    toggleEnqBtn.classList.add('active');
    toggleDesBtn?.classList.remove('active');
    if (recentEnqList) recentEnqList.style.display = 'flex';
    if (recentDesList) recentDesList.style.display = 'none';
  });

  toggleDesBtn?.addEventListener('click', () => {
    toggleDesBtn.classList.add('active');
    toggleEnqBtn?.classList.remove('active');
    if (recentEnqList) recentEnqList.style.display = 'none';
    if (recentDesList) recentDesList.style.display = 'flex';
  });

  // Jump to all enquiries arrow
  document.getElementById('jumpToAllEnquiriesBtn')?.addEventListener('click', () => {
    switchTab('view-enquiries');
  });

  // Mobile menu toggle
  document.getElementById('mobileMenuToggle')?.addEventListener('click', () => {
    document.getElementById('adminSidebar')?.classList.toggle('open');
  });

  // Logout button handler
  document.getElementById('adminLogoutBtn')?.addEventListener('click', async () => {
    if (confirm('Are you sure you want to log out of Admin Panel?')) {
      try {
        await fetch('/api/admin/auth', { method: 'DELETE' });
        window.location.href = '/admin/login';
      } catch (e) {
        window.location.href = '/admin/login';
      }
    }
  });

  // ========================================================
  // CATEGORIES CRUD LOGIC
  // ========================================================
  const categoryModal = document.getElementById('categoryModal');
  const categoryForm = document.getElementById('categoryForm') as HTMLFormElement;
  const openAddCategoryModalBtn = document.getElementById('openAddCategoryModalBtn');
  const closeCategoryModalBtn = document.getElementById('closeCategoryModalBtn');
  const cancelCategoryBtn = document.getElementById('cancelCategoryBtn');
  const catImagePreset = document.getElementById('catImagePreset') as HTMLSelectElement;
  const catImageInput = document.getElementById('catImageInput') as HTMLInputElement;

  catImagePreset?.addEventListener('change', () => {
    if (catImagePreset.value !== 'custom') {
      catImageInput.value = catImagePreset.value;
    }
  });

  openAddCategoryModalBtn?.addEventListener('click', () => {
    if (!categoryModal) return;
    categoryForm.reset();
    (document.getElementById('editCategoryId') as HTMLInputElement).value = '';
    (document.getElementById('categoryModalTitle') as HTMLElement).textContent = 'Add New Category';
    catImageInput.value = '/images/products/meat-pads.jpg';
    categoryModal.style.display = 'flex';
  });

  closeCategoryModalBtn?.addEventListener('click', () => {
    if (categoryModal) categoryModal.style.display = 'none';
  });

  cancelCategoryBtn?.addEventListener('click', () => {
    if (categoryModal) categoryModal.style.display = 'none';
  });

  // Edit category buttons
  document.querySelectorAll<HTMLButtonElement>('.btn-edit-category').forEach(btn => {
    btn.addEventListener('click', (e) => {
      e.stopPropagation();
      const raw = btn.getAttribute('data-category');
      if (!raw || !categoryModal) return;
      const cat = JSON.parse(raw);

      (document.getElementById('editCategoryId') as HTMLInputElement).value = cat.id;
      (document.getElementById('catNameInput') as HTMLInputElement).value = cat.name;
      (document.getElementById('catImageInput') as HTMLInputElement).value = cat.image;
      (document.getElementById('catStatusInput') as HTMLSelectElement).value = cat.status || 'Active';
      (document.getElementById('catDescInput') as HTMLTextAreaElement).value = cat.description || '';
      (document.getElementById('categoryModalTitle') as HTMLElement).textContent = `Edit Category: ${cat.name}`;

      categoryModal.style.display = 'flex';
    });
  });

  // Save category submission
  categoryForm?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const id = (document.getElementById('editCategoryId') as HTMLInputElement).value;
    const name = (document.getElementById('catNameInput') as HTMLInputElement).value;
    const image = (document.getElementById('catImageInput') as HTMLInputElement).value;
    const status = (document.getElementById('catStatusInput') as HTMLSelectElement).value;
    const description = (document.getElementById('catDescInput') as HTMLTextAreaElement).value;

    const payload = { name, image, status, description };

    try {
      const url = id ? `/api/categories/${id}` : '/api/categories';
      const method = id ? 'PUT' : 'POST';

      const res = await fetch(url, {
        method,
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload)
      });

      if (res.ok) {
        showToast(id ? 'Category updated successfully' : 'New category created');
        if (categoryModal) categoryModal.style.display = 'none';
        setTimeout(() => window.location.reload(), 600);
      } else {
        showToast('Error saving category', true);
      }
    } catch (err: any) {
      showToast(err.message || 'Network error', true);
    }
  });

  // Delete Category
  document.querySelectorAll<HTMLButtonElement>('.btn-delete-category').forEach(btn => {
    btn.addEventListener('click', async (e) => {
      e.stopPropagation();
      const id = btn.getAttribute('data-id');
      const name = btn.getAttribute('data-name');
      if (!id) return;

      if (confirm(`Are you sure you want to delete category "${name}"?`)) {
        try {
          const res = await fetch(`/api/categories/${id}`, { method: 'DELETE' });
          if (res.ok) {
            showToast(`Category "${name}" deleted`);
            btn.closest('tr')?.remove();
          } else {
            showToast('Failed to delete category', true);
          }
        } catch (err: any) {
          showToast(err.message, true);
        }
      }
    });
  });

  // View Category in public catalogue
  document.querySelectorAll<HTMLButtonElement>('.btn-view-cat-products').forEach(btn => {
    btn.addEventListener('click', (e) => {
      e.stopPropagation();
      const slug = btn.getAttribute('data-slug') || '';
      window.open(`/catalogue?category=${slug}`, '_blank');
    });
  });

  // Inquiry Status Change in full table
  document.querySelectorAll<HTMLSelectElement>('.status-dropdown-select').forEach(sel => {
    sel.addEventListener('change', async () => {
      const inqId = sel.getAttribute('data-id');
      const newStatus = sel.value;
      if (!inqId) return;

      try {
        const res = await fetch(`/api/inquiries/${inqId}`, {
          method: 'PATCH',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ status: newStatus })
        });
        if (res.ok) {
          showToast(`Status updated to ${newStatus}`);
        } else {
          showToast('Failed to update status', true);
        }
      } catch (err: any) {
        showToast(err.message || 'Error updating status', true);
      }
    });
  });

  // Inquiry Detail Modal
  const inquiryModal = document.getElementById('inquiryDetailModal');
  const inquiryModalBody = document.getElementById('inquiryModalBody');
  const closeInquiryModalBtn = document.getElementById('closeInquiryModalBtn');

  function openInquiryModal(inqData: any) {
    if (!inquiryModal || !inquiryModalBody) return;

    const dateObj = inqData.created_at ? new Date(inqData.created_at) : new Date();
    const formattedDate = dateObj.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });

    let deadlineVal = inqData.deadline || '';
    if (deadlineVal && deadlineVal.includes('T')) {
      deadlineVal = deadlineVal.split('T')[0];
    }

    const currentStatus = String(inqData.status || 'Pending').trim();
    const statusOptions = ['Pending', 'New', 'Contacted', 'Quoted', 'Sampling', 'Closed', 'Cancelled'];

    inquiryModalBody.innerHTML = `
      <div style="display: flex; flex-direction: column; gap: 16px; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; color: #1E293B;">
        
        <!-- Top Meta: ENQUIRY ID & DATE RECEIVED -->
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px; padding-bottom: 12px; border-bottom: 1px solid #E2E8F0;">
          <div>
            <div style="font-size: 11px; font-weight: 700; color: #64748B; text-transform: uppercase; letter-spacing: 0.5px;">ENQUIRY ID</div>
            <div style="font-size: 14px; font-weight: 600; color: #0F172A; font-family: monospace; margin-top: 3px;">${inqData.inquiry_no || inqData.id}</div>
          </div>
          <div>
            <div style="font-size: 11px; font-weight: 700; color: #64748B; text-transform: uppercase; letter-spacing: 0.5px;">DATE RECEIVED</div>
