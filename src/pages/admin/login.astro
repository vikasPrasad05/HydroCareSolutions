---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { isAdminAuthenticated } from '../../lib/auth';

export const prerender = false;

// If already authenticated, redirect to /admin
if (isAdminAuthenticated(Astro.cookies)) {
  return Astro.redirect('/admin');
}
---

<AdminLayout title="Admin Portal Login — Absorbent Pads">
  <div class="login-page-wrapper">
    <div class="login-card">
      <div class="login-brand">
        <div class="brand-logo-badge">
          <img src="/favicon.svg" alt="HydroCare Solutions" class="login-brand-logo" width="52" height="52" />
        </div>
        <h2 class="brand-heading">HydroCare Solutions</h2>
        <p class="brand-sub">ADMIN PORTAL &bull; MANUFACTURING CONTROL</p>
      </div>

      <div class="login-notice">
        <span>🔐 Secure access to incoming buyer enquiries, product lines, and factory orders.</span>
      </div>

      <form id="adminLoginForm" class="login-form">
        <div class="form-group">
          <label for="adminSecretKey" class="form-label">Admin Secret Key / PIN *</label>
          <input 
            type="password" 
            id="adminSecretKey" 
            name="key" 
            class="form-input" 
            placeholder="Enter admin secret key" 
            required 
            autofocus 
          />
          <span class="field-hint">Default Demo Key: <strong>admin12345</strong></span>
        </div>

        <div id="loginErrorMsg" class="login-error" style="display: none;"></div>

        <button type="submit" id="loginSubmitBtn" class="btn-gold-submit">
          <span>Authenticate & Access Dashboard</span>
        </button>
      </form>
    </div>
  </div>
</AdminLayout>

<style>
  .login-page-wrapper {
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: #F8FAFC;
    padding: 24px;
    box-sizing: border-box;
  }

  .login-card {
    width: 100%;
    max-width: 420px;
    background: #FFFFFF;
    border: 1px solid #E2E8F0;
    border-radius: 12px;
    padding: 36px 32px;
    box-shadow: 0 4px 20px -2px rgba(0, 0, 0, 0.05), 0 2px 4px -1px rgba(0, 0, 0, 0.02);
  }

  .login-brand {
    text-align: center;
    margin-bottom: 24px;
  }

  .brand-logo-badge {
    margin: 0 auto 12px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  .login-brand-logo {
    width: 52px;
    height: 52px;
    object-fit: contain;
    display: block;
    filter: drop-shadow(0 4px 10px rgba(0, 53, 128, 0.12));
  }

  .brand-heading {
    font-family: 'Outfit', 'Plus Jakarta Sans', sans-serif;
    font-size: 24px;
    color: #0F172A;
    font-weight: 800;
    letter-spacing: -0.02em;
  }

  .brand-sub {
    font-size: 11px;
    color: #64748B;
    letter-spacing: 0.1em;
    font-weight: 600;
    margin-top: 3px;
  }

  .login-notice {
    background: #F8FAFC;
    border: 1px solid #E2E8F0;
    padding: 12px 14px;
    border-radius: 8px;
    font-size: 12px;
    color: #475569;
    margin-bottom: 20px;
    line-height: 1.4;
  }

  .form-group {
    display: flex;
    flex-direction: column;
    margin-bottom: 20px;
  }

  .form-label {
    font-size: 12.5px;
    font-weight: 500;
    color: #334155;
    margin-bottom: 6px;
  }

  .form-input {
    width: 100%;
    padding: 10px 14px;
    border: 1px solid #E2E8F0;
    border-radius: 8px;
    font-size: 14px;
    font-family: 'DM Mono', monospace;
    box-sizing: border-box;
    transition: border-color 0.15s, box-shadow 0.15s;
    background-color: #FFFFFF;
    color: #0F172A;
  }

  .form-input:focus {
    outline: none;
    border-color: #0F172A;
    box-shadow: 0 0 0 3px rgba(15, 23, 42, 0.08);
  }

  .field-hint {
    font-size: 11.5px;
    color: #64748B;
    margin-top: 6px;
  }

  .field-hint strong {
    color: #0F172A;
  }

  .login-error {
    background: #FEF2F2;
    border: 1px solid #FCA5A5;
    color: #991B1B;
    padding: 10px 14px;
    border-radius: 8px;
    font-size: 12.5px;
    margin-bottom: 16px;
  }

  .btn-gold-submit {
    width: 100%;
    padding: 11px 16px;
    font-size: 13.5px;
    font-weight: 600;
    color: #FFFFFF;
    background-color: #0F172A;
    border: none;
    border-radius: 8px;
    cursor: pointer;
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.05);
    transition: background-color 0.15s ease, transform 0.1s ease;
  }

  .btn-gold-submit:hover {
    background-color: #1E293B;
  }

  .btn-gold-submit:active {
    transform: translateY(1px);
  }
</style>

<script>
  const form = document.getElementById('adminLoginForm');
  const errorMsg = document.getElementById('loginErrorMsg');
  const submitBtn = document.getElementById('loginSubmitBtn');

  if (form) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (errorMsg) errorMsg.style.display = 'none';

      const formData = new FormData(form as HTMLFormElement);
      const key = formData.get('key');

      if (submitBtn) submitBtn.setAttribute('disabled', 'true');

      try {
        const res = await fetch('/api/admin/auth', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ key })
        });

        const data = await res.json();
        if (!res.ok || !data.success) {
          throw new Error(data.error || 'Authentication failed');
        }

        // Redirect to admin dashboard
        window.location.href = '/admin';
      } catch (err: any) {
        if (errorMsg) {
          errorMsg.textContent = err.message || 'Invalid secret key. Please try again.';
          errorMsg.style.display = 'block';
        }
      } finally {
        if (submitBtn) submitBtn.removeAttribute('disabled');
      }
    });
  }
</script>
