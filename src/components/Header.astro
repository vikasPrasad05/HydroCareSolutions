<script>
  // Mobile Menu Toggling
  const menuBtn = document.getElementById('mobileMenuBtn');
  const menu = document.getElementById('mobileMenu');
  if (menuBtn && menu) {
    menuBtn.addEventListener('click', () => {
      menu.classList.toggle('open');
    });
  }

  // Mobile Products Accordion
  const mobileProdToggle = document.getElementById('mobileProductsToggle');
  const mobileSubCats = document.getElementById('mobileSubCats');
  if (mobileProdToggle && mobileSubCats) {
    mobileProdToggle.addEventListener('click', () => {
      mobileSubCats.classList.toggle('open');
      const arrow = mobileProdToggle.querySelector('.mobile-arrow');
      if (arrow) {
        arrow.textContent = mobileSubCats.classList.contains('open') ? '▴' : '▾';
      }
    });
  }

  // Mega Menu Category Hover & Click Switcher
  const catTabBtns = document.querySelectorAll('.cat-tab-btn');
  const catPanels = document.querySelectorAll('.category-panel');
  const headerCatTitle = document.getElementById('panelCategoryTitle');

  function activateTab(btn: Element) {
    const targetPanelId = btn.getAttribute('data-target');
    const catTitle = btn.getAttribute('data-cat-title');

    // Update active tab buttons
    catTabBtns.forEach(b => {
      b.classList.remove('active');
      b.setAttribute('aria-selected', 'false');
    });
    btn.classList.add('active');
    btn.setAttribute('aria-selected', 'true');

    // Update active category panels
    catPanels.forEach(p => p.classList.remove('active'));
    if (targetPanelId) {
      const targetPanel = document.getElementById(targetPanelId);
      if (targetPanel) targetPanel.classList.add('active');
    }

    // Update title in header
    if (headerCatTitle && catTitle) headerCatTitle.textContent = catTitle;
  }

  catTabBtns.forEach((btn) => {
    btn.addEventListener('mouseenter', () => activateTab(btn));
    btn.addEventListener('click', () => activateTab(btn));
  });

  // Track Order Click Handler (Opens Global Track Modal)
  const navTrackBtn = document.getElementById('btnNavTrack');
  const mobileNavTrackBtn = document.getElementById('mobileMenuTrackBtn');

  function handleTrackModalClick(e: Event) {
    if (typeof (window as any).openTrackQuoteModal === 'function') {
      e.preventDefault();
      const mobileMenuEl = document.getElementById('mobileMenu');
      if (mobileMenuEl && mobileMenuEl.classList.contains('open')) {
        mobileMenuEl.classList.remove('open');
      }
      (window as any).openTrackQuoteModal();
    }
  }

  navTrackBtn?.addEventListener('click', handleTrackModalClick);
  mobileNavTrackBtn?.addEventListener('click', handleTrackModalClick);
</script>
