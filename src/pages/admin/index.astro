  // ==========================================
  // CUSTOMER REVIEWS VIEW LOGIC (MATCHES SCREENSHOT)
  // ==========================================
  const reviewStatusFilter = document.getElementById('reviewStatusFilter') as HTMLSelectElement;
  const reviewsPageSizeSelect = document.getElementById('reviewsPageSizeSelect') as HTMLSelectElement;
  const reviewsShowingText = document.getElementById('reviewsShowingText');
  const reviewsPageLabel = document.getElementById('reviewsPageLabel');
  const reviewsFirstBtn = document.getElementById('reviewsFirstBtn') as HTMLButtonElement;
  const reviewsPrevBtn = document.getElementById('reviewsPrevBtn') as HTMLButtonElement;
  const reviewsNextBtn = document.getElementById('reviewsNextBtn') as HTMLButtonElement;
  const reviewsLastBtn = document.getElementById('reviewsLastBtn') as HTMLButtonElement;

  let currentRevPage = 1;
  let revPageSize = 10;

  function getReviewRows(): HTMLTableRowElement[] {
    return Array.from(document.querySelectorAll<HTMLTableRowElement>('#reviewsTableBody tr.review-row-item'));
  }

  function filterAndPaginateReviews() {
    const filterVal = (reviewStatusFilter?.value || '').trim().toLowerCase();
    const allRows = getReviewRows();
    const matchedRows: HTMLTableRowElement[] = [];

    allRows.forEach(row => {
      const status = (row.getAttribute('data-status') || '').toLowerCase();
      const visibility = (row.getAttribute('data-visibility') || '').toLowerCase();

      let matches = false;
      if (!filterVal || filterVal === 'all reviews') {
        matches = true;
      } else if (filterVal === 'approved' && status === 'approved') {
        matches = true;
      } else if (filterVal === 'pending' && status === 'pending') {
        matches = true;
      } else if (filterVal === 'hidden' && visibility === 'hidden') {
        matches = true;
      } else if (filterVal === 'visible' && visibility === 'visible') {
        matches = true;
      }

      if (matches) {
        matchedRows.push(row);
      } else {
        row.style.display = 'none';
      }
    });

    const totalMatched = matchedRows.length;
    revPageSize = parseInt(reviewsPageSizeSelect?.value || '10', 10);
    const totalPages = Math.max(1, Math.ceil(totalMatched / revPageSize));

    if (currentRevPage > totalPages) currentRevPage = totalPages;
    if (currentRevPage < 1) currentRevPage = 1;

    const startIndex = (currentRevPage - 1) * revPageSize;
    const endIndex = startIndex + revPageSize;

    matchedRows.forEach((row, idx) => {
      if (idx >= startIndex && idx < endIndex) {
        row.style.display = '';
      } else {
        row.style.display = 'none';
      }
    });

    const displayStart = totalMatched === 0 ? 0 : startIndex + 1;
    const displayEnd = Math.min(endIndex, totalMatched);

    if (reviewsShowingText) {
      reviewsShowingText.textContent = `Showing ${displayStart} to ${displayEnd} of ${totalMatched} reviews`;
    }

    if (reviewsPageLabel) {
      reviewsPageLabel.textContent = `Page ${currentRevPage} of ${totalPages}`;
    }

    if (reviewsFirstBtn) reviewsFirstBtn.disabled = currentRevPage <= 1;
    if (reviewsPrevBtn) reviewsPrevBtn.disabled = currentRevPage <= 1;
    if (reviewsNextBtn) reviewsNextBtn.disabled = currentRevPage >= totalPages;
    if (reviewsLastBtn) reviewsLastBtn.disabled = currentRevPage >= totalPages;
  }

  reviewStatusFilter?.addEventListener('change', () => {
    currentRevPage = 1;
    filterAndPaginateReviews();
  });

  reviewsPageSizeSelect?.addEventListener('change', () => {
    currentRevPage = 1;
    filterAndPaginateReviews();
  });

  reviewsFirstBtn?.addEventListener('click', () => {
    currentRevPage = 1;
    filterAndPaginateReviews();
  });

  reviewsPrevBtn?.addEventListener('click', () => {
    if (currentRevPage > 1) {
      currentRevPage--;
      filterAndPaginateReviews();
    }
  });

  reviewsNextBtn?.addEventListener('click', () => {
    currentRevPage++;
    filterAndPaginateReviews();
  });

  reviewsLastBtn?.addEventListener('click', () => {
    const allRows = getReviewRows();
    const totalPages = Math.max(1, Math.ceil(allRows.length / revPageSize));
    currentRevPage = totalPages;
    filterAndPaginateReviews();
  });

  // Action dots toggle dropdown
  document.querySelectorAll<HTMLElement>('.action-dots-btn').forEach(btn => {
    btn.addEventListener('click', (e) => {
