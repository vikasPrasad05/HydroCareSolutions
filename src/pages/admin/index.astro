    }

    const headers = ['Date', 'Priority', 'Contact Name', 'Phone', 'Email', 'Product', 'Variant/Fabric', 'Quantity', 'Status', 'Message'];
    const csvLines = [headers.join(',')];

    rows.forEach(r => {
      const dataStr = r.getAttribute('data-inquiry');
      if (dataStr) {
        try {
          const inq = JSON.parse(dataStr);
          const date = inq.created_at ? new Date(inq.created_at).toLocaleDateString() : '';
          const priority = inq.priority || 'Medium';
          const name = `"${(inq.company_name || inq.name || '').replace(/"/g, '""')}"`;
          const phone = `"${(inq.phone || '').replace(/"/g, '""')}"`;
          const email = `"${(inq.email || '').replace(/"/g, '""')}"`;
          const product = `"${(inq.product_name || '').replace(/"/g, '""')}"`;
          const variant = `"${(inq.fabric_choice || inq.customization_type || '').replace(/"/g, '""')}"`;
          const qty = inq.quantity || 100;
          const status = inq.status || 'Pending';
          const msg = `"${(inq.message || '').replace(/"/g, '""')}"`;

          csvLines.push([date, priority, name, phone, email, product, variant, qty, status, msg].join(','));
        } catch {}
      }
    });

    const csvContent = 'data:text/csv;charset=utf-8,' + encodeURIComponent(csvLines.join('\n'));
    const link = document.createElement('a');
    link.setAttribute('href', csvContent);
