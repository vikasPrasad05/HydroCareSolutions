          row.setAttribute('data-status', newStatus.toLowerCase());
          const statPill = row.querySelector('.review-status-pill');
          if (statPill) {
            statPill.className = `review-status-pill ${newStatus.toLowerCase()}`;
            statPill.textContent = newStatus;
          }
          btn.textContent = newStatus === 'Approved' ? '⏳ Set Pending' : '✓ Approve Review';
